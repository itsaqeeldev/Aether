<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment2">

    <fragment
        android:id="@+id/homeFragment2"
        android:name="com.devsphere.aether.ui.HomeFragment"
        android:label="HomeFragment" />
    <fragment
        android:id="@+id/locationsFragment2"
        android:name="com.devsphere.aether.ui.LocationsFragment"
        android:label="fragment_locations"
        tools:layout="@layout/fragment_locations" >
        <action
            android:id="@+id/action_locationsFragment2_to_cityWeatherFragment"
            app:destination="@id/cityWeatherFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment2"
        android:name="com.devsphere.aether.ui.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" />
    <fragment
        android:id="@+id/whatToWearFragment2"
        android:name="com.devsphere.aether.ui.WhatToWearFragment"
        android:label="fragment_what_to_wear"
        tools:layout="@layout/fragment_what_to_wear" />
    <fragment
        android:id="@+id/cityWeatherFragment"
        android:name="com.devsphere.aether.ui.CityWeatherFragment"
        android:label="CityWeatherFragment" >
        <!-- Arguments -->
        <argument
            android:name="locationId"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="cityName"
            app:argType="string"
            android:defaultValue="Unknown" />
        <argument
            android:name="country"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="countryCode"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="latitude"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="longitude"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="timezone"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
</navigation>