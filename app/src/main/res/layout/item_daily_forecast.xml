<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Day Name -->
    <TextView
        android:id="@+id/txtDayName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textColor="@color/aether_text_primary"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtDate"
        app:layout_constraintEnd_toStartOf="@id/icWeather"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.25" />

    <!-- Date -->
    <TextView
        android:id="@+id/txtDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Dec 15"
        android:textColor="@color/aether_text_tertiary"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@id/txtDayName"
        app:layout_constraintTop_toBottomOf="@id/txtDayName"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/txtDayName" />

    <!-- Weather Icon -->
    <ImageView
        android:id="@+id/icWeather"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_sun"
        app:tint="@color/aether_amber_glow"
        app:layout_constraintStart_toEndOf="@id/txtDayName"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Condition Text -->
    <TextView
        android:id="@+id/txtCondition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sunny"
        android:textColor="@color/aether_text_secondary"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/icWeather"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/precipContainer"
        app:layout_constraintHorizontal_bias="0" />

    <!-- Precipitation Container -->
    <LinearLayout
        android:id="@+id/precipContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@id/tempContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/icRain"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_rain"
            android:visibility="gone"
            app:tint="@color/aether_blue_end" />

        <TextView
            android:id="@+id/txtPrecipProb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="30%"
            android:textColor="@color/aether_blue_end"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Temperature Container -->
    <LinearLayout
        android:id="@+id/tempContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/txtHighTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24°"
            android:textColor="@color/aether_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "
            android:textColor="@color/aether_text_tertiary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtLowTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18°"
            android:textColor="@color/aether_text_tertiary"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>