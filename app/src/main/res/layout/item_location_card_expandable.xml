<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- MAIN LOCATION CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLocation"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:clipToOutline="true"
        android:clickable="true"
        android:focusable="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- BACKGROUND IMAGE -->
            <ImageView
                android:id="@+id/imgBackground"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/default_img"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- GRADIENT OVERLAY -->
            <View
                android:id="@+id/bottomOverlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/hero_gradient_overlay"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- TOP CONTENT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- COUNTRY PILL -->
                <LinearLayout
                    android:id="@+id/pillCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/pill_bg_glass"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/aether_soft_lavender" />

                    <TextView
                        android:id="@+id/txtCountry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="USA"
                        android:textColor="@color/aether_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- FAVORITE STAR -->
                <ImageView
                    android:id="@+id/btnFavorite"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:background="@drawable/gradient_primary_round"
                    android:src="@drawable/ic_star_filled"
                    app:tint="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/pillCountry" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- CITY NAME -->
            <TextView
                android:id="@+id/txtCity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="San Francisco"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/aether_text_primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/weatherRow" />

            <!-- WEATHER ROW -->
            <LinearLayout
                android:id="@+id/weatherRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingBottom="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/icWeather"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_sun"
                    app:tint="@color/aether_amber_glow" />

                <TextView
                    android:id="@+id/txtCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Sunny"
                    android:textColor="@color/aether_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="24°"
                    android:textColor="@color/aether_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- EXPAND INDICATOR -->
            <ImageView
                android:id="@+id/icExpand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/aether_text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- EXPANDABLE DETAIL CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        android:visibility="gone"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/neo_card_bottom_rounded"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <!-- Coordinates Label -->
            <TextView
                android:id="@+id/txtCoordinatesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coordinates"
                android:textSize="14sp"
                android:textColor="@color/aether_text_secondary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Coordinates Value -->
            <TextView
                android:id="@+id/txtCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="37.77°N, 122.41°W"
                android:textSize="14sp"
                android:textColor="@color/aether_text_primary"
                app:layout_constraintBaseline_toBaselineOf="@id/txtCoordinatesLabel"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Buttons Row -->
            <LinearLayout
                android:id="@+id/rowButtons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/txtCoordinatesLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- View Details Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewDetails"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="View Details"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/aether_purple_start"
                    app:cornerRadius="12dp" />

                <!-- Remove Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnfavorite"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:text="Remove"
                    android:textAllCaps="false"
                    android:textColor="@color/aether_text_secondary"
                    app:strokeColor="@color/aether_frost_18"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>