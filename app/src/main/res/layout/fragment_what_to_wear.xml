<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollWhatToWear"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:saveEnabled="false"
    android:background="@color/aether_bg_dark"
    android:fillViewport="true"
    android:overScrollMode="never">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:saveEnabled="false"
        android:background="@color/aether_bg_dark"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- ================================
                     TOP BAR
            ==================================-->
            <LinearLayout
                android:id="@+id/topBarWhatToWear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="40dp"
                android:paddingBottom="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What to Wear"
                        android:textColor="@color/aether_text_primary"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/txtSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="AI-powered outfit suggestions"
                        android:textColor="@color/aether_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/headerIconContainer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/gradient_primary_round"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/icWardrobe"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_sun"
                        app:tint="@color/white" />
                </FrameLayout>
            </LinearLayout>

            <!-- ================================
                  CURRENT CONDITIONS CARD
            ==================================-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCurrentConditions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:backgroundTint="@android:color/transparent"
                app:layout_constraintTop_toBottomOf="@id/topBarWhatToWear"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/neo_card"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/conditionsTextBlock"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/conditionsIcon"
                        app:layout_constraintHorizontal_bias="0">

                        <TextView
                            android:id="@+id/txtCurrentConditionsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Conditions"
                            android:textColor="@color/aether_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtCurrentTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="24°C"
                            android:textColor="@color/aether_text_primary"
                            android:textSize="26sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/txtCurrentCondition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Partly Cloudy"
                            android:textColor="@color/aether_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/conditionsIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/gradient_ocean"
                        android:padding="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:id="@+id/icCurrentWeather"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_sun"
                            app:tint="@color/white" />
                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================================
                  STYLE SELECTOR (TABLAYOUT)
            ==================================-->
            <TextView
                android:id="@+id/txtStyleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Your Style"
                android:textColor="@color/aether_text_secondary"
                android:textSize="14sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/cardCurrentConditions"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/tab_container_bg"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabRippleColor="@android:color/transparent"
                app:tabIndicator="@drawable/tab_indicator_style"
                app:tabIndicatorGravity="center"
                app:tabIndicatorHeight="40dp"
                app:tabIndicatorFullWidth="false"
                app:tabTextColor="@color/style_tab_text_selector"
                app:layout_constraintTop_toBottomOf="@id/txtStyleLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Casual" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Formal" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Sport" />

            </com.google.android.material.tabs.TabLayout>

            <!-- ================================
                  RECOMMENDED ITEMS SECTION (RecyclerView)
            ==================================-->
            <TextView
                android:id="@+id/txtRecommendedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:text="Recommended Items"
                android:textColor="@color/aether_text_primary"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/tabStyle"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRecommendedItems"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/txtRecommendedLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ================================
                     TODAY'S TIPS (RecyclerView)
            ==================================-->
            <TextView
                android:id="@+id/txtTipsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:text="Today's Tips"
                android:textColor="@color/aether_text_primary"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/recyclerRecommendedItems"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/txtTipsLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ================================
                     SMART INSIGHT CARD
            ==================================-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSmartInsight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:backgroundTint="@android:color/transparent"
                app:layout_constraintTop_toBottomOf="@id/recyclerTips"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/neo_card"
                    android:padding="20dp">

                    <FrameLayout
                        android:id="@+id/iconSmartInsight"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/gradient_ocean"
                        android:padding="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/icSmartInsight"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_smile"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtSmartInsightTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Smart Insight"
                        android:textColor="@color/aether_text_primary"
                        android:textSize="18sp"
                        app:layout_constraintStart_toEndOf="@id/iconSmartInsight"
                        app:layout_constraintTop_toTopOf="@id/iconSmartInsight"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/txtSmartInsightBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:text="Loading insights..."
                        android:textColor="@color/aether_text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintStart_toEndOf="@id/iconSmartInsight"
                        app:layout_constraintTop_toBottomOf="@id/txtSmartInsightTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================================
                 PERFECT WEATHER FOR (RecyclerView with GridLayout)
            ==================================-->
            <TextView
                android:id="@+id/txtPerfectWeatherLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:text="Perfect Weather For"
                android:textColor="@color/aether_text_primary"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/cardSmartInsight"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerActivities"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/txtPerfectWeatherLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>